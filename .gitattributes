# Keep the real export, the blueprint and the golden reports byte-for-byte: no line-ending
# conversion (the golden tests compare bytes, LF endings included).
tests/fixtures/** -text
tests/golden/** -text
docs/BLUEPRINT.md -text
# Source files always use LF, whatever the platform.
*.rs text eol=lf
*.toml text eol=lf
Cargo.lock text eol=lf
