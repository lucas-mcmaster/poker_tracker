# poker_tracker editor settings (https://editorconfig.org).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true

[*.rs]
indent_style = space
indent_size = 4

# Verbatim GGPoker hands: opponent "Dealt to" lines end with a space. Never trim them.
[{tests/fixtures/**,tests/common/mod.rs,docs/BLUEPRINT.md}]
trim_trailing_whitespace = false
